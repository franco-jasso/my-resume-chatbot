# --- Producción pública (Render, Railway, etc.) — Google Gemini ---
GENAI_API_KEY=tu_api_key_de_google_ai_studio
GENAI_PROVIDER=google
GENAI_MODEL=gemini-2.0-flash

# Puerto (local: 5000; en la nube lo asigna el hosting)
PORT=5000